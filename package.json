{
  "name": "usance",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @usance/web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "dev": "pnpm --filter @usance/web dev",
    "api": "pnpm --filter @usance/api dev"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "viem": "^2.55.16",
    "vitest": "^2.1.8"
  }
}
