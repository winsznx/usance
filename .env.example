# Usance environment. Copy to .env and fill in. Never commit .env.
#
# Everything here is optional for `make test` — the deterministic suites need no network and no
# credentials. These are only needed for live paths.

# ---------------------------------------------------------------- X Layer
# Defaults are the public endpoints verified in docs/INTEGRATIONS.md. Override for a private RPC.
XLAYER_RPC_URL=https://rpc.xlayer.tech
XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech
XLAYER_CHAIN_ID=1952

# ERC-8021 attribution appended to every write path. `usance` is the code we will register.
USANCE_BUILDER_CODE=usance

# ---------------------------------------------------------------- deployment
# Required only by `make deploy-testnet`. Use a key that holds nothing but test gas.
DEPLOYER_PRIVATE_KEY=
# Governance and guardian addresses. Default to the deployer, which is fine on testnet and is
# not fine on mainnet — the deploy script drops the deployer's governance role when these differ.
USANCE_GOVERNANCE=
USANCE_GUARDIAN=
# Settlement asset and its Chainlink aggregator on the target chain.
USANCE_SETTLEMENT_TOKEN=
USANCE_SETTLEMENT_FEED=
# Chainlink L2 Sequencer Uptime feed. Optional; absence is recorded rather than assumed healthy.
USANCE_SEQUENCER_FEED=

# ---------------------------------------------------------------- ChainGPT
# Without this, evidence extraction runs a single deterministic path and every Passport built
# that way is marked singleSource and capped by policy. It does not silently degrade.
CHAINGPT_API_KEY=

# ---------------------------------------------------------------- OKX DEX
# The DEX API is not the DEX Interface. These credentials drive the API adapter only, and API
# execution is never presented as qualifying Interface volume.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# ---------------------------------------------------------------- Exchange OS / TradeZone
# Names are placeholders until builder access is granted and the real variables are documented.
# No adapter reads them today.
EXCHANGE_OS_API_KEY=
